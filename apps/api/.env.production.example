# ── Required ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Provided automatically by Railway PostgreSQL plugin
DATABASE_URL=postgresql://user:pass@host:5432/dbname
DIRECT_URL=postgresql://user:pass@host:5432/dbname

# Provided automatically by Railway Redis plugin
REDIS_URL=redis://default:pass@host:6379

# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Your Vercel web app URL (set after deploying web)
ALLOWED_ORIGINS=https://your-app.vercel.app
APP_BASE_URL=https://your-api.railway.app

# ── AI (optional — leave placeholder to disable) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Storage (use Railway S3-compatible or AWS) ───────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=eduai-production
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=eduai-production

# ── Payments ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_...
EMAIL_FROM=noreply@yourdomain.com

# ── Elasticsearch (optional — leave empty to disable search) ─────────────────
ELASTICSEARCH_NODE=https://your-cluster.es.io:9243
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
