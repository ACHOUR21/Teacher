NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://eduai:password@localhost:5432/eduai_db
DIRECT_URL=postgresql://eduai:password@localhost:5432/eduai_db

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=change_me_at_least_32_chars
JWT_REFRESH_SECRET=change_me_different_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS (comma-separated origins, or set CORS_ALLOW_ALL=true for dev)
ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL=true

# SMTP (use MailHog for local dev: host=localhost port=1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@eduai.local

# App URL (used in email links)
APP_URL=http://localhost:3000

# AI APIs (optional for local dev)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe (optional for local dev)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# S3 / MinIO (use MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=eduai
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# OpenTelemetry (set to true to enable)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=eduai-api

# Firebase Cloud Messaging (required for push notifications)
# Get this from Firebase Console > Project Settings > Cloud Messaging > Server key
FCM_SERVER_KEY=
