{
  "name": "@eduai/ai",
  "version": "1.0.0",
  "description": "AI client utilities, RAG pipeline, and education-domain system prompts for EduAI Ultimate",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.js --format cjs,esm --clean",
    "dev": "tsup src/index.js --format cjs,esm --watch",
    "lint": "eslint src --ext .js",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@eduai/shared": "workspace:*",
    "openai": "^4.40.0",
    "tiktoken": "^1.0.15"
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  },
  "keywords": [
    "eduai",
    "ai",
    "openai",
    "anthropic",
    "rag",
    "embeddings"
  ],
  "license": "UNLICENSED",
  "private": true
}
