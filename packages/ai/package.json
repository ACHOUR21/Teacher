{
  "name": "@eduai/ai",
  "version": "1.0.0",
  "description": "AI client utilities, RAG pipeline, and education-domain system prompts for EduAI Ultimate",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@eduai/shared": "*",
    "openai": "^4.40.0",
    "tiktoken": "^1.0.15"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": ["eduai", "ai", "openai", "anthropic", "rag", "embeddings"],
  "license": "UNLICENSED",
  "private": true
}
