{
  "name": "@eduai/shared",
  "version": "1.0.0",
  "description": "Shared types, enums, constants, and utilities for EduAI Ultimate platform",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./enums": {
      "import": "./dist/enums/index.mjs",
      "require": "./dist/enums/index.js"
    },
    "./types": {
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./constants": {
      "import": "./dist/constants/index.mjs",
      "require": "./dist/constants/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.js --format cjs,esm --clean",
    "dev": "tsup src/index.js --format cjs,esm --watch",
    "lint": "eslint src --ext .js",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  },
  "keywords": [
    "eduai",
    "shared",
    "types",
    "enums"
  ],
  "license": "UNLICENSED",
  "private": true
}
