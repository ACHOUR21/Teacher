# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
API_PREFIX=api/v1
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://eduai:password@localhost:5432/eduai_db
DIRECT_URL=postgresql://eduai:password@localhost:5432/eduai_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=false

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_KEY_PREFIX=eduai:

# ─── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=eduai_

# ─── JWT Authentication ─────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-also-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=eduai-ultimate
JWT_AUDIENCE=eduai-users

# ─── MFA / 2FA ─────────────────────────────────────────────────────────────────
MFA_ISSUER=EduAI Ultimate
MFA_TOKEN_WINDOW=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_ENABLED=false

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@eduai.io
EMAIL_FROM_NAME=EduAI Ultimate
EMAIL_TEMPLATES_DIR=./templates/email

# ─── Object Storage (S3 / MinIO) ───────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eduai
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRES=3600
CDN_URL=

# ─── AI — OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# ─── AI — Anthropic Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=8192

# ─── AI — Vector Database (Pinecone / Qdrant) ──────────────────────────────────
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=eduai_embeddings
VECTOR_EMBEDDING_DIMENSION=3072

# ─── AI — Rate Limiting ────────────────────────────────────────────────────────
AI_REQUESTS_PER_MINUTE=60
AI_TOKENS_PER_DAY_FREE=10000
AI_TOKENS_PER_DAY_STARTER=100000
AI_TOKENS_PER_DAY_PROFESSIONAL=500000
AI_TOKENS_PER_DAY_BUSINESS=2000000
AI_TOKENS_PER_DAY_ENTERPRISE=-1

# ─── Payments — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_PAYMENT_METHODS=card,sepa_debit,ideal

# ─── Payments — PayPal ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# ─── Firebase (Push Notifications) ────────────────────────────────────────────
FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── OAuth / Social Login ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/microsoft/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# ─── LMS Integrations ──────────────────────────────────────────────────────────
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
CANVAS_API_URL=
CANVAS_API_TOKEN=
MOODLE_URL=
MOODLE_TOKEN=
SCORM_CLOUD_APP_ID=
SCORM_CLOUD_SECRET_KEY=

# ─── Video Conferencing ────────────────────────────────────────────────────────
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_WEBHOOK_SECRET=
JITSI_APP_ID=
JITSI_APP_SECRET=
JITSI_DOMAIN=meet.jit.si
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ─── Monitoring & Observability ───────────────────────────────────────────────
# Backend Sentry (NestJS API) — only active when NODE_ENV=production and SENTRY_DSN is set
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=eduai-ultimate
# Frontend Sentry (Next.js) — NEXT_PUBLIC_ prefix exposes it to the browser
NEXT_PUBLIC_SENTRY_DSN=
# OpenTelemetry
OTEL_SERVICE_NAME=eduai-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
PROMETHEUS_METRICS_PORT=9091

# ─── Rate Limiting & Throttling ───────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# ─── Multi-tenancy / White Label ──────────────────────────────────────────────
DEFAULT_TENANT_DOMAIN=app.eduai.io
TENANT_ISOLATION_STRATEGY=schema
CUSTOM_DOMAIN_SSL=true
WHITE_LABEL_ENABLED=true

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_AI_TUTOR=true
FEATURE_LIVE_SESSIONS=true
FEATURE_MOBILE_APP=true
FEATURE_MARKETPLACE=false
FEATURE_BLOCKCHAIN_CERTS=false
FEATURE_AR_VR=false

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=session-secret-at-least-32-chars-change-in-prod
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
