# ─── EduAI Ultimate — Production Environment ───────────────────────────────────
# Copy to production.env and fill in real values. Store secrets in AWS Secrets
# Manager / HashiCorp Vault — never commit this file with real values.

# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://eduai.example.com
API_URL=https://api.eduai.example.com
PORT=4000
API_PREFIX=api/v1
LOG_LEVEL=warn
CORS_ORIGINS=https://eduai.example.com,https://app.eduai.example.com

# ─── Database (RDS PostgreSQL Multi-AZ) ──────────────────────────────────────
DATABASE_URL=postgresql://eduai_prod:CHANGE_ME@prod-rds-primary.cluster.us-east-1.rds.amazonaws.com:5432/eduai_production
DIRECT_URL=postgresql://eduai_prod:CHANGE_ME@prod-rds-primary.cluster.us-east-1.rds.amazonaws.com:5432/eduai_production
DATABASE_READ_URL=postgresql://eduai_prod:CHANGE_ME@prod-rds-replica.cluster.us-east-1.rds.amazonaws.com:5432/eduai_production
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL=true
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=100
DATABASE_IDLE_TIMEOUT=10000
DATABASE_CONNECT_TIMEOUT=30000

# ─── Redis (ElastiCache Cluster) ──────────────────────────────────────────────
REDIS_URL=rediss://prod-redis.cache.amazonaws.com:6380
REDIS_PASSWORD=CHANGE_ME
REDIS_TLS=true
REDIS_KEY_PREFIX=eduai_prod:
REDIS_RETRY_ATTEMPTS=20
REDIS_RETRY_DELAY=1000
REDIS_CLUSTER_MODE=true

# ─── Elasticsearch (OpenSearch Managed) ───────────────────────────────────────
ELASTICSEARCH_URL=https://prod-es.us-east-1.es.amazonaws.com
ELASTICSEARCH_USERNAME=CHANGE_ME
ELASTICSEARCH_PASSWORD=CHANGE_ME
ELASTICSEARCH_INDEX_PREFIX=eduai_prod_
ELASTICSEARCH_MAX_RETRIES=5
ELASTICSEARCH_REQUEST_TIMEOUT=30000
ELASTICSEARCH_REPLICAS=2
ELASTICSEARCH_SHARDS=5

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Minimum 64 characters. Rotate every 90 days. Store in Secrets Manager.
JWT_SECRET=CHANGE_ME_prod_jwt_secret_min_64_chars_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_REFRESH_SECRET=CHANGE_ME_prod_refresh_secret_min_64_chars_XXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=eduai-ultimate
JWT_AUDIENCE=eduai-users

# ─── MFA / 2FA ────────────────────────────────────────────────────────────────
MFA_ISSUER=EduAI Ultimate
MFA_TOKEN_WINDOW=1
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=CHANGE_ME
MFA_ENFORCE_FOR_ADMINS=true

# ─── AI Services ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_RATE_LIMIT_PER_HOUR=2000
VECTOR_DB_URL=https://prod-index.svc.pinecone.io
VECTOR_DB_API_KEY=CHANGE_ME
VECTOR_DB_ENVIRONMENT=production
VECTOR_DB_INDEX=eduai-prod
AI_FALLBACK_PROVIDER=openai
AI_CIRCUIT_BREAKER_THRESHOLD=5

# ─── Storage (S3 + CloudFront) ────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=eduai-production-assets
S3_BUCKET_REGION=us-east-1
S3_BUCKET_PRIVATE=eduai-production-private
CLOUDFRONT_URL=https://cdn.eduai.example.com
CLOUDFRONT_KEY_PAIR_ID=CHANGE_ME
CLOUDFRONT_PRIVATE_KEY=CHANGE_ME
MAX_UPLOAD_SIZE_MB=500
S3_SIGNED_URL_EXPIRY=3600

# ─── Email (SES + SendGrid fallback) ──────────────────────────────────────────
EMAIL_FROM=noreply@eduai.example.com
EMAIL_FROM_NAME=EduAI Ultimate
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SECURE=true
SENDGRID_API_KEY=CHANGE_ME
EMAIL_BOUNCE_WEBHOOK_SECRET=CHANGE_ME

# ─── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_CONNECT_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_MODE=live
PAYMENT_ENCRYPTION_KEY=CHANGE_ME_32_char_key_XXXXXXXXXXXXXXXXX
TAX_API_KEY=CHANGE_ME

# ─── WebSocket / Socket.IO ────────────────────────────────────────────────────
SOCKET_IO_CORS=https://eduai.example.com
SOCKET_IO_TRANSPORTS=websocket
SOCKET_IO_STICKY_SESSION=true
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000
WS_MAX_CONNECTIONS_PER_USER=5

# ─── Queue (BullMQ) ───────────────────────────────────────────────────────────
QUEUE_REDIS_URL=rediss://prod-queue-redis.cache.amazonaws.com:6380
QUEUE_REDIS_PASSWORD=CHANGE_ME
QUEUE_CONCURRENCY_EMAIL=20
QUEUE_CONCURRENCY_AI=10
QUEUE_CONCURRENCY_EXPORT=5
QUEUE_CONCURRENCY_CERTIFICATE=10
QUEUE_JOB_RETENTION=72

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=200
AI_THROTTLE_TTL=60
AI_THROTTLE_LIMIT=30
UPLOAD_THROTTLE_TTL=60
UPLOAD_THROTTLE_LIMIT=10

# ─── Monitoring & Observability ───────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.eduai.example.com:4318
OTEL_SERVICE_NAME=eduai-api
OTEL_ENVIRONMENT=production
SENTRY_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.01
DATADOG_API_KEY=CHANGE_ME
DATADOG_AGENT_HOST=datadog-agent
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_AUTH_TOKEN=CHANGE_ME
LOG_FORMAT=json
LOG_REQUESTS=false
LOG_SENSITIVE_REDACT=true

# ─── CDN & Performance ────────────────────────────────────────────────────────
CDN_ENABLED=true
RESPONSE_CACHE_TTL=300
STATIC_CACHE_TTL=31536000
API_CACHE_ENABLED=true
COMPRESSION_ENABLED=true
BROTLI_ENABLED=true

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_AI_TUTOR=true
FEATURE_LIVE_CLASSROOM=true
FEATURE_MARKETPLACE=true
FEATURE_WHITE_LABEL=true
FEATURE_API_ECOSYSTEM=true
FEATURE_GAMIFICATION=true
FEATURE_CERTIFICATES=true
FEATURE_PARENT_PORTAL=true
FEATURE_PLUGIN_MARKETPLACE=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_AI_AGENTS=true
FEATURE_CARRIER_ADVISOR=true

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=CHANGE_ME_32_char_encryption_key_XXXXXXXXXXXXXXXXXX
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
SESSION_COOKIE_DOMAIN=.eduai.example.com
COOKIE_SECRET=CHANGE_ME_long_random_cookie_secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_IP_ALLOWLIST=CHANGE_ME_vpn_cidr/32
CSP_REPORT_URI=https://eduai.example.com/csp-report
HSTS_MAX_AGE=31536000
IP_REPUTATION_API_KEY=CHANGE_ME
WAF_ENABLED=true

# ─── Kubernetes / Health ──────────────────────────────────────────────────────
HEALTH_CHECK_PATH=/api/v1/health
READINESS_CHECK_PATH=/api/v1/health/ready
LIVENESS_CHECK_PATH=/api/v1/health/live
SHUTDOWN_TIMEOUT_MS=60000
GRACEFUL_SHUTDOWN_DELAY=10000

# ─── Tenant ───────────────────────────────────────────────────────────────────
DEFAULT_TENANT_DOMAIN=eduai.example.com
TENANT_CACHE_TTL=600
MAX_TENANTS=10000
TENANT_SUBDOMAIN_REGEX=^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$

# ─── Certificate Generation ───────────────────────────────────────────────────
CERTIFICATE_SIGNING_KEY=CHANGE_ME_certificate_signing_key_256_bits
CERTIFICATE_ISSUER_NAME=EduAI Ultimate
CERTIFICATE_BASE_URL=https://certs.eduai.example.com
CERTIFICATE_VERIFY_URL=https://verify.eduai.example.com

# ─── Multi-Region (optional) ──────────────────────────────────────────────────
AWS_REGION_PRIMARY=us-east-1
AWS_REGION_SECONDARY=eu-west-1
GEO_ROUTING_ENABLED=false

# ─── Compliance ───────────────────────────────────────────────────────────────
GDPR_DATA_RETENTION_DAYS=2555
FERPA_ENABLED=true
COPPA_AGE_THRESHOLD=13
AUDIT_LOG_RETENTION_DAYS=2555
DATA_EXPORT_EXPIRY_HOURS=48
